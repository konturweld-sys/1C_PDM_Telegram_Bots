// Подготовка табличных документов PDM к передаче в Telegram или Email.

Функция РезультатПодготовкиВложения(Успех, ИмяФайла = "", Расширение = "", Данные = Неопределено, Размер = 0, КодОшибки = "", ТекстОшибки = "")

    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("ИмяФайла", ИмяФайла);
    Результат.Вставить("Расширение", Расширение);
    Результат.Вставить("ДвоичныеДанные", Данные);
    Результат.Вставить("Размер", Размер);
    Результат.Вставить("КодОшибки", КодОшибки);
    Результат.Вставить("ТекстОшибки", ТекстОшибки);

    Возврат Результат;

КонецФункции

Функция ПодготовитьВложение(РезультатОтчета, ФорматФайла) Экспорт

    Если РезультатОтчета = Неопределено
        ИЛИ РезультатОтчета.ТабличныйДокумент = Неопределено Тогда
        Возврат РезультатПодготовкиВложения(
            Ложь,
            "",
            "",
            Неопределено,
            0,
            "REPORT_DOCUMENT_EMPTY",
            "Не передан табличный документ отчёта.");
    КонецЕсли;

    Если ТипЗнч(ФорматФайла) = Тип("Строка") Тогда
        Расширение = ВРег(ФорматФайла);
    Иначе
        Расширение = ВРег(Строка(ФорматФайла));
    КонецЕсли;

    Если ПустаяСтрока(Расширение) Тогда
        Расширение = "PDF";
    КонецЕсли;

    ИмяФайла = СокрЛП(РезультатОтчета.НаименованиеФайла);
    Если ПустаяСтрока(ИмяФайла) Тогда
        ИмяФайла = "Отчет";
    КонецЕсли;

    ИмяФайла = ИмяФайла + "." + НРег(Расширение);
    ИмяВременногоФайла = ПолучитьИмяВременногоФайла(НРег(Расширение));

    Попытка

        РезультатОтчета.ТабличныйДокумент.Записать(
            ИмяВременногоФайла,
            ТипФайлаТабличногоДокумента[Расширение]);

        ДанныеФайла = Новый ДвоичныеДанные(ИмяВременногоФайла);
        Файл = Новый Файл(ИмяВременногоФайла);
        РазмерФайла = Файл.Размер;

        УдалитьФайлы(ИмяВременногоФайла);

        Возврат РезультатПодготовкиВложения(
            Истина,
            ИмяФайла,
            Расширение,
            ДанныеФайла,
            РазмерФайла);

    Исключение

        ТекстОшибки = ОписаниеОшибки();

        Попытка
            УдалитьФайлы(ИмяВременногоФайла);
        Исключение
            ТекстОшибкиУдаления = ОписаниеОшибки();
        КонецПопытки;

        Возврат РезультатПодготовкиВложения(
            Ложь,
            "",
            Расширение,
            Неопределено,
            0,
            "REPORT_ATTACHMENT_FAILED",
            ТекстОшибки);

    КонецПопытки;

КонецФункции

&НаКлиенте
Процедура ПоказатьРезультатОтчета(РезультатОтчета) Экспорт

    Если РезультатОтчета = Неопределено
        ИЛИ РезультатОтчета.ТабличныйДокумент = Неопределено Тогда
        ВызватьИсключение "Не передан результат отчёта для отображения.";
    КонецЕсли;

    Заголовок = РезультатОтчета.НаименованиеФайла;
    Если ПустаяСтрока(Заголовок) Тогда
        Заголовок = "Результат отчёта";
    КонецЕсли;

    РезультатОтчета.ТабличныйДокумент.Показать(Заголовок);

КонецПроцедуры
