// Серверный адаптер отправки Email через SMTP-профиль PDM.
// Пароль SMTP используется только в памяти сервера и не сохраняется в Telegram-регистрах.

Функция СкрытьПарольSMTP(ТекстОшибки, Пароль)

    Если ПустаяСтрока(Пароль) Тогда
        Возврат ТекстОшибки;
    КонецЕсли;

    Возврат СтрЗаменить(ТекстОшибки, Пароль, "[ПАРОЛЬ SMTP СКРЫТ]");

КонецФункции

Функция РезультатОтправки(Успех, ИдентификаторСообщения, СтатусыПолучателей, КодОшибки = "", ТекстОшибки = "")

    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("ИдентификаторСообщения", ИдентификаторСообщения);
    Результат.Вставить("СтатусыПолучателей", СтатусыПолучателей);
    Результат.Вставить("КодОшибки", КодОшибки);
    Результат.Вставить("ТекстОшибки", ТекстОшибки);

    Возврат Результат;

КонецФункции

Функция ПолучитьПрофильПочты(СсылкаПрофиля)

    Если ЗначениеЗаполнено(СсылкаПрофиля) Тогда
        НастройкаПочты = СсылкаПрофиля.ПолучитьОбъект();
    Иначе
        НастройкаПочты = Константы.aps_НастройкаПочтыДляУведомлений.Получить();
        Если ЗначениеЗаполнено(НастройкаПочты) Тогда
            НастройкаПочты = НастройкаПочты.ПолучитьОбъект();
        КонецЕсли;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(НастройкаПочты) Тогда
        ВызватьИсключение "Не настроен SMTP-профиль PDM.";
    КонецЕсли;

    Если ПустаяСтрока(НастройкаПочты.АдресСервераSMTP)
        ИЛИ НастройкаПочты.ПортSMTP = 0
        ИЛИ ПустаяСтрока(НастройкаПочты.Адрес) Тогда
        ВызватьИсключение "SMTP-профиль PDM заполнен не полностью.";
    КонецЕсли;

    Профиль = Новый ИнтернетПочтовыйПрофиль;
    Профиль.АдресСервераSMTP = НастройкаПочты.АдресСервераSMTP;
    Профиль.ПортSMTP = НастройкаПочты.ПортSMTP;

    Если НастройкаПочты.ТребуетсяSMTPАутентификация Тогда

        Если ПустаяСтрока(НастройкаПочты.ИмяПользователяSMTP)
            ИЛИ ПустаяСтрока(НастройкаПочты.ПарольSMTP) Тогда
            ВызватьИсключение "В SMTP-профиле PDM не заполнены параметры аутентификации.";
        КонецЕсли;

        Профиль.АутентификацияSMTP = СпособSMTPАутентификации.ПоУмолчанию;
        Профиль.ПользовательSMTP = НастройкаПочты.ИмяПользователяSMTP;
        Профиль.ПарольSMTP = НастройкаПочты.ПарольSMTP;

    Иначе

    КонецЕсли;

    Возврат Новый Структура("НастройкаПочты,Профиль", НастройкаПочты, Профиль);

КонецФункции

Функция СоздатьПочтовоеСообщение(ПараметрыОтправки, НастройкаПочты, АдресПолучателя)

    Сообщение = Новый ИнтернетПочтовоеСообщение;
    Сообщение.Отправитель = НастройкаПочты.Адрес;
    Сообщение.ИмяОтправителя = НастройкаПочты.Наименование;
    Сообщение.Тема = ПараметрыОтправки.Тема;

    Получатель = Сообщение.Получатели.Добавить();
    Получатель.Адрес = АдресПолучателя;

    ТекстСообщения = Сообщение.Тексты.Добавить();
    ТекстСообщения.Текст = ПараметрыОтправки.Текст;

    ФорматТекста = "";
    ПараметрыОтправки.Свойство("Формат", ФорматТекста);

    Если ВРег(ФорматТекста) = "HTML" Тогда
        ТекстСообщения.ТипТекста = ТипТекстаПочтовогоСообщения.HTML;
    Иначе
        // Markdown передаётся как обычный текст: автоматическая HTML-конвертация не выполняется.
        ТекстСообщения.ТипТекста = ТипТекстаПочтовогоСообщения.ПростойТекст;
    КонецЕсли;

    Вложения = Новый Массив;
    ПараметрыОтправки.Свойство("Вложения", Вложения);

    Если ТипЗнч(Вложения) <> Тип("Массив") Тогда
        ВызватьИсключение "Вложения должны передаваться массивом.";
    КонецЕсли;

    Для Каждого Вложение Из Вложения Цикл

        ДанныеВложения = Неопределено;
        ИмяФайла = "";

        Если НЕ Вложение.Свойство("ДвоичныеДанные", ДанныеВложения)
            ИЛИ ДанныеВложения = Неопределено Тогда
            ВызватьИсключение "Одно из вложений не содержит двоичные данные.";
        КонецЕсли;

        Если НЕ Вложение.Свойство("ИмяФайла", ИмяФайла)
            ИЛИ ПустаяСтрока(ИмяФайла) Тогда
            ВызватьИсключение "Для вложения не задано имя файла.";
        КонецЕсли;

        Если ТипЗнч(ДанныеВложения) = Тип("ХранилищеЗначения") Тогда
            ДанныеВложения = ДанныеВложения.Получить();
        КонецЕсли;

        Сообщение.Вложения.Добавить(ДанныеВложения, ИмяФайла);

    КонецЦикла;

    Возврат Сообщение;

КонецФункции

Функция ОтправитьЭлектронноеСообщение(ПараметрыОтправки) Экспорт

    ИдентификаторСообщения = Строка(Новый УникальныйИдентификатор());
    СтатусыПолучателей = Новый Массив;

    Если ТипЗнч(ПараметрыОтправки) <> Тип("Структура") Тогда
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_INVALID_PARAMETERS",
            "Параметры отправки Email должны иметь тип Структура.");
    КонецЕсли;

    Получатели = Новый Массив;
    Тема = "";
    Текст = "";

    ПараметрыОтправки.Свойство("Получатели", Получатели);
    ПараметрыОтправки.Свойство("Тема", Тема);
    ПараметрыОтправки.Свойство("Текст", Текст);

    Если ТипЗнч(Получатели) <> Тип("Массив") Тогда
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_RECIPIENTS_INVALID",
            "Список получателей Email должен иметь тип Массив.");
    КонецЕсли;

    Если Получатели.Количество() = 0 Тогда
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_RECIPIENTS_EMPTY",
            "Не заданы получатели Email.");
    КонецЕсли;

    Если ПустаяСтрока(Тема) Тогда
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_CONTENT_EMPTY",
            "Не заданы тема или текст Email.");
    КонецЕсли;

    СсылкаПрофиля = Неопределено;
    ПараметрыОтправки.Свойство("ПрофильПочты", СсылкаПрофиля);

    Попытка
        ДанныеПрофиля = ПолучитьПрофильПочты(СсылкаПрофиля);
    Исключение
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_PROFILE_INVALID",
            ОписаниеОшибки());
    КонецПопытки;

    Почта = Новый ИнтернетПочта;
    Подключено = Ложь;

    Попытка
        Почта.Подключиться(ДанныеПрофиля.Профиль);
        Подключено = Истина;
    Исключение
        ТекстОшибкиПодключения = ОписаниеОшибки();
        ТекстОшибкиПодключения = СкрытьПарольSMTP(
            ТекстОшибкиПодключения,
            ДанныеПрофиля.НастройкаПочты.ПарольSMTP);
        Для Каждого АдресПолучателя Из Получатели Цикл
            СтатусыПолучателей.Добавить(
                Новый Структура("Адрес,Статус,ТекстОшибки",
                    АдресПолучателя,
                    Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка,
                    ТекстОшибкиПодключения));
        КонецЦикла;
        Возврат РезультатОтправки(
            Ложь,
            ИдентификаторСообщения,
            СтатусыПолучателей,
            "EMAIL_CONNECT_FAILED",
            ТекстОшибкиПодключения);
    КонецПопытки;

    КоличествоОшибок = 0;

    Для Каждого АдресПолучателя Из Получатели Цикл

        Если ПустаяСтрока(АдресПолучателя) Тогда
            КоличествоОшибок = КоличествоОшибок + 1;
            СтатусыПолучателей.Добавить(
                Новый Структура("Адрес,Статус,ТекстОшибки",
                    АдресПолучателя,
                    Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка,
                    "Пустой адрес получателя."));
            Продолжить;
        КонецЕсли;

        Попытка

            Сообщение = СоздатьПочтовоеСообщение(
                ПараметрыОтправки,
                ДанныеПрофиля.НастройкаПочты,
                АдресПолучателя);

            Почта.Послать(Сообщение);

            СтатусыПолучателей.Добавить(
                Новый Структура("Адрес,Статус,ТекстОшибки",
                    АдресПолучателя,
                    Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено,
                    ""));

        Исключение

            КоличествоОшибок = КоличествоОшибок + 1;
            СтатусыПолучателей.Добавить(
                Новый Структура("Адрес,Статус,ТекстОшибки",
                    АдресПолучателя,
                    Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка,
                    СкрытьПарольSMTP(
                        ОписаниеОшибки(),
                        ДанныеПрофиля.НастройкаПочты.ПарольSMTP)));

        КонецПопытки;

    КонецЦикла;

    Если Подключено Тогда
        Попытка
            Почта.Отключиться();
        Исключение
            ТекстОшибкиОтключения = ОписаниеОшибки();
        КонецПопытки;
    КонецЕсли;

    Возврат РезультатОтправки(
        КоличествоОшибок = 0,
        ИдентификаторСообщения,
        СтатусыПолучателей,
        ?(КоличествоОшибок = 0, "", "EMAIL_PARTIAL_FAILURE"),
        ?(КоличествоОшибок = 0, "", "Не все письма были приняты SMTP-сервером."));

КонецФункции
