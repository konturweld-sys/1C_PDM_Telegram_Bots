// Серверный адаптер штатного безопасного хранилища PDM.
// Идентификатор владельца совместим с ранее сохранёнными токенами:
// "УБТ_Бот_" + строковое представление UUID бота.
// Для обратной совместимости используется ключ "Пароль".

Процедура ЗаписатьТокенБота(UUIDБота, Токен) Экспорт

	Если Не ЗначениеЗаполнено(UUIDБота) Тогда
		ВызватьИсключение "Не задан идентификатор бота.";
	КонецЕсли;

	Если Не ЗначениеЗаполнено(Токен) Тогда
		ВызватьИсключение "Не задан токен Telegram-бота.";
	КонецЕсли;

	ИдентификаторБота = "УБТ_Бот_" + Строка(UUIDБота);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбщегоНазначения.ЗаписатьДанныеВБезопасноеХранилище(ИдентификаторБота, Токен);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПрочитатьТокенБота(UUIDБота) Экспорт

	Если Не ЗначениеЗаполнено(UUIDБота) Тогда
		ВызватьИсключение "Не задан идентификатор бота.";
	КонецЕсли;

	ИдентификаторБота = "УБТ_Бот_" + Строка(UUIDБота);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Токен = ОбщегоНазначения.ПрочитатьДанныеИзБезопасногоХранилища(ИдентификаторБота, "Пароль");
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Возврат Токен;

КонецФункции

Процедура УдалитьТокенБота(UUIDБота) Экспорт

	Если Не ЗначениеЗаполнено(UUIDБота) Тогда
		ВызватьИсключение "Не задан идентификатор бота.";
	КонецЕсли;

	ИдентификаторБота = "УБТ_Бот_" + Строка(UUIDБота);

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		ОбщегоНазначения.УдалитьДанныеИзБезопасногоХранилища(ИдентификаторБота);
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
