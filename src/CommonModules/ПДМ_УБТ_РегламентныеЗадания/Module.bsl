// Серверный адаптер платформенного менеджера регламентных заданий.
// Интерфейс совместим с вызовами Telegram-библиотеки upstream 0.18.0.

Процедура ПроверитьАдминистратораБотов()

    Если НЕ РольДоступна("УБТ_АдминистраторБотовTelegram") Тогда
        ВызватьИсключение "Недостаточно прав для управления регламентными заданиями Telegram.";
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьЗаданияПлатформы(Отбор)

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

    Возврат Задания;

КонецФункции

Функция ЗаписатьЗаданиеПлатформы(Задание)

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Задание.Записать();
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

    Возврат Задание;

КонецФункции

// Определяет владельца по метаданным регламентного задания и его параметрам.
// Для бота параметром является код, для сценария — UUID ссылки.
Функция ПолучитьВладельцаЗадания(МетаданныеЗадания, ПараметрыЗадания)

    Если ТипЗнч(ПараметрыЗадания) <> Тип("Массив")
        ИЛИ ПараметрыЗадания.Количество() = 0 Тогда
        ВызватьИсключение "Не удалось определить владельца регламентного задания Telegram.";
    КонецЕсли;

    Если МетаданныеЗадания = Метаданные.РегламентныеЗадания.УБТ_ВзаимодействиеСБотамиTelegram Тогда

        Владелец = Справочники.УБТ_БотыTelegram.НайтиПоКоду(ПараметрыЗадания[0]);

    ИначеЕсли МетаданныеЗадания = Метаданные.РегламентныеЗадания.УБТ_ИсполнениеСценариевTelegramБотов Тогда

        Владелец = Справочники.УБТ_СценарииБотовTelegram.ПолучитьСсылку(
            Новый УникальныйИдентификатор(ПараметрыЗадания[0]));

    Иначе

        ВызватьИсключение "Неподдерживаемый тип регламентного задания Telegram.";

    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(Владелец)
        ИЛИ НЕ ПДМ_УБТ_Права.ИзменениеРазрешено(Владелец) Тогда
        ВызватьИсключение "Недостаточно прав на изменение владельца регламентного задания.";
    КонецЕсли;

    Возврат Владелец;

КонецФункции

Функция НайтиЗадания(Отбор) Экспорт

    ПроверитьАдминистратораБотов();

    Если Отбор = Неопределено Тогда
        Отбор = Новый Структура;
    КонецЕсли;

    Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
        ВызватьИсключение "Отбор регламентных заданий должен иметь тип Структура.";
    КонецЕсли;

    Возврат ПолучитьЗаданияПлатформы(Отбор);

КонецФункции

Функция ДобавитьЗадание(Параметры) Экспорт

    ПроверитьАдминистратораБотов();

    Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
        ВызватьИсключение "Параметры создания регламентного задания должны иметь тип Структура.";
    КонецЕсли;

    МетаданныеЗадания = Неопределено;
    Ключ = "";
    ПараметрыЗадания = Новый Массив;
    ИмяПользователя = "";
    Расписание = Неопределено;
    Наименование = "";
    Использование = Истина;

    Если НЕ Параметры.Свойство("Метаданные", МетаданныеЗадания)
        ИЛИ МетаданныеЗадания = Неопределено Тогда
        ВызватьИсключение "Не заданы метаданные регламентного задания.";
    КонецЕсли;

    Если НЕ Параметры.Свойство("Ключ", Ключ)
        ИЛИ ПустаяСтрока(Ключ) Тогда
        ВызватьИсключение "Для параметризованного задания обязателен уникальный ключ.";
    КонецЕсли;

    Параметры.Свойство("Параметры", ПараметрыЗадания);
    Параметры.Свойство("ИмяПользователя", ИмяПользователя);
    Параметры.Свойство("Расписание", Расписание);
    Параметры.Свойство("Наименование", Наименование);
    Параметры.Свойство("Использование", Использование);

    Если ТипЗнч(ПараметрыЗадания) <> Тип("Массив") Тогда
        ВызватьИсключение "Параметры регламентного задания должны быть массивом.";
    КонецЕсли;

    Если Расписание = Неопределено Тогда
        ВызватьИсключение "Не задано расписание регламентного задания.";
    КонецЕсли;

    Если ПустаяСтрока(Наименование) Тогда
        ВызватьИсключение "Не задано наименование регламентного задания.";
    КонецЕсли;

    ПолучитьВладельцаЗадания(МетаданныеЗадания, ПараметрыЗадания);

    Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданныеЗадания);
    Задание.Ключ = Ключ;
    Задание.Параметры = ПараметрыЗадания;
    Задание.ИмяПользователя = ИмяПользователя;
    Задание.Расписание = Расписание;
    Задание.Наименование = Наименование;
    Задание.Использование = Использование;

    Возврат ЗаписатьЗаданиеПлатформы(Задание);

КонецФункции

Функция ИзменитьЗадание(Задание, СвойстваЗадания) Экспорт

    ПроверитьАдминистратораБотов();

    Если Задание = Неопределено
        ИЛИ ТипЗнч(СвойстваЗадания) <> Тип("Структура") Тогда
        ВызватьИсключение "Для изменения задания необходим объект задания и структура свойств.";
    КонецЕсли;

    ПараметрыЗадания = Задание.Параметры;
    СвойстваЗадания.Свойство("Параметры", ПараметрыЗадания);
    ПолучитьВладельцаЗадания(Задание.Метаданные, ПараметрыЗадания);

    ЗначениеСвойства = Неопределено;
    Если СвойстваЗадания.Свойство("ИмяПользователя", ЗначениеСвойства) Тогда
        Задание.ИмяПользователя = ЗначениеСвойства;
    КонецЕсли;

    Если СвойстваЗадания.Свойство("Параметры", ЗначениеСвойства) Тогда
        Если ТипЗнч(ЗначениеСвойства) <> Тип("Массив") Тогда
            ВызватьИсключение "Параметры регламентного задания должны быть массивом.";
        КонецЕсли;
        Задание.Параметры = ЗначениеСвойства;
    КонецЕсли;

    Если СвойстваЗадания.Свойство("Расписание", ЗначениеСвойства) Тогда
        Задание.Расписание = ЗначениеСвойства;
    КонецЕсли;

    Если СвойстваЗадания.Свойство("Наименование", ЗначениеСвойства) Тогда
        Задание.Наименование = ЗначениеСвойства;
    КонецЕсли;

    Если СвойстваЗадания.Свойство("Использование", ЗначениеСвойства) Тогда
        Задание.Использование = ЗначениеСвойства;
    КонецЕсли;

    Возврат ЗаписатьЗаданиеПлатформы(Задание);

КонецФункции

Процедура УдалитьЗадание(Задание) Экспорт

    ПроверитьАдминистратораБотов();

    Если Задание = Неопределено Тогда
        ВызватьИсключение "Не задан объект регламентного задания.";
    КонецЕсли;

    ПолучитьВладельцаЗадания(Задание.Метаданные, Задание.Параметры);

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Если Задание.Метаданные.Предопределенное Тогда
            Задание.Использование = Ложь;
            Задание.Записать();
        Иначе
            Задание.Удалить();
        КонецЕсли;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
