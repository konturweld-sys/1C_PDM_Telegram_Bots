// Серверный адаптер платформенного менеджера регламентных заданий.
// Привилегированный режим включается только на время вызова менеджера
// и балансируется даже при исключении.

Процедура ПроверитьАдминистратораБотов()

    Если НЕ РольДоступна("УБТ_АдминистраторБотовTelegram") Тогда
        ВызватьИсключение "Недостаточно прав для управления регламентными заданиями Telegram.";
    КонецЕсли;

КонецПроцедуры

Функция ПолучитьЗаданияПлатформы(Отбор)

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Задания = РегламентныеЗадания.ПолучитьРегламентныеЗадания(Отбор);
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

    Возврат Задания;

КонецФункции

Функция ЗаписатьЗаданиеПлатформы(Задание, МетаданныеЗадания = Неопределено)

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Если Задание = Неопределено Тогда
            Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданныеЗадания);
        КонецЕсли;
        Задание.Записать();
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

    Возврат Задание;

КонецФункции

Функция РезультатОперации(Успех, КодОшибки = "", ТекстОшибки = "", Задание = Неопределено, Создано = Ложь)

    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("КодОшибки", КодОшибки);
    Результат.Вставить("ТекстОшибки", ТекстОшибки);
    Результат.Вставить("Задание", Задание);
    Результат.Вставить("Создано", Создано);
    Результат.Вставить("УникальныйИдентификатор", Неопределено);

    Если Задание <> Неопределено Тогда
        Результат.УникальныйИдентификатор = Задание.УникальныйИдентификатор;
    КонецЕсли;

    Возврат Результат;

КонецФункции

Функция НайтиЗадания(Отбор) Экспорт

    ПроверитьАдминистратораБотов();

    Если Отбор = Неопределено Тогда
        Отбор = Новый Структура;
    КонецЕсли;

    Если ТипЗнч(Отбор) <> Тип("Структура") Тогда
        ВызватьИсключение "Отбор регламентных заданий должен иметь тип Структура.";
    КонецЕсли;

    Возврат ПолучитьЗаданияПлатформы(Отбор);

КонецФункции

Функция ДобавитьЗадание(Параметры) Экспорт

    ПроверитьАдминистратораБотов();

    Если ТипЗнч(Параметры) <> Тип("Структура") Тогда
        ВызватьИсключение "Параметры создания регламентного задания должны иметь тип Структура.";
    КонецЕсли;

    МетаданныеЗадания = Неопределено;
    Ключ = "";
    ПараметрыЗадания = Новый Массив;
    ИдентификаторПользователяИБ = Неопределено;
    Расписание = Неопределено;
    Наименование = "";
    Использование = Истина;
    Владелец = Неопределено;

    Если НЕ Параметры.Свойство("МетаданныеЗадания", МетаданныеЗадания)
        ИЛИ МетаданныеЗадания = Неопределено Тогда
        ВызватьИсключение "Не задан объект метаданных регламентного задания.";
    КонецЕсли;

    Если НЕ Параметры.Свойство("Ключ", Ключ)
        ИЛИ ПустаяСтрока(Ключ) Тогда
        ВызватьИсключение "Для параметризованного задания обязателен уникальный ключ.";
    КонецЕсли;

    Параметры.Свойство("Параметры", ПараметрыЗадания);
    Параметры.Свойство("ИдентификаторПользователяИБ", ИдентификаторПользователяИБ);
    Параметры.Свойство("Расписание", Расписание);
    Параметры.Свойство("Наименование", Наименование);
    Параметры.Свойство("Использование", Использование);
    Параметры.Свойство("Владелец", Владелец);

    Если ТипЗнч(ПараметрыЗадания) <> Тип("Массив") Тогда
        ВызватьИсключение "Параметры регламентного задания должны быть массивом.";
    КонецЕсли;

    Если ИдентификаторПользователяИБ = Неопределено Тогда
        ВызватьИсключение "Не задан UUID пользователя информационной базы для регламентного задания.";
    КонецЕсли;

    Если Расписание = Неопределено Тогда
        ВызватьИсключение "Не задано расписание регламентного задания.";
    КонецЕсли;

    Если ПустаяСтрока(Наименование) Тогда
        ВызватьИсключение "Не задано наименование регламентного задания.";
    КонецЕсли;

    Если Владелец = Неопределено
        ИЛИ НЕ ПДМ_УБТ_Права.ИзменениеРазрешено(Владелец) Тогда
        ВызватьИсключение "Недостаточно прав на изменение владельца регламентного задания.";
    КонецЕсли;

    Отбор = Новый Структура;
    Отбор.Вставить("Метаданные", МетаданныеЗадания);
    Отбор.Вставить("Ключ", Ключ);
    НайденныеЗадания = ПолучитьЗаданияПлатформы(Отбор);

    Если НайденныеЗадания.Количество() > 1 Тогда
        Возврат РезультатОперации(
            Ложь,
            "SCHEDULE_DUPLICATE",
            "Найдено несколько регламентных заданий с одинаковыми метаданными и ключом.");
    КонецЕсли;

    Создано = НайденныеЗадания.Количество() = 0;
    Задание = Неопределено;
    Если НЕ Создано Тогда
        Задание = НайденныеЗадания[0];
    КонецЕсли;

    ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
        ИдентификаторПользователяИБ);
    Если ПользовательИБ = Неопределено Тогда
        Возврат РезультатОперации(
            Ложь,
            "SCHEDULE_USER_NOT_FOUND",
            "Пользователь информационной базы для регламентного задания не найден.");
    КонецЕсли;

    Попытка
        Если Задание = Неопределено Тогда
            УстановитьПривилегированныйРежим(Истина);
            Попытка
                Задание = РегламентныеЗадания.СоздатьРегламентноеЗадание(МетаданныеЗадания);
                Задание.Ключ = Ключ;
                Задание.Параметры = ПараметрыЗадания;
                Задание.ИмяПользователя = ПользовательИБ;
                Задание.Расписание = Расписание;
                Задание.Наименование = Наименование;
                Задание.Использование = Использование;
                Задание.Записать();
            Исключение
                ТекстОшибки = ОписаниеОшибки();
                УстановитьПривилегированныйРежим(Ложь);
                ВызватьИсключение ТекстОшибки;
            КонецПопытки;
            УстановитьПривилегированныйРежим(Ложь);
        Иначе
            Задание.Ключ = Ключ;
            Задание.Параметры = ПараметрыЗадания;
            Задание.ИмяПользователя = ПользовательИБ;
            Задание.Расписание = Расписание;
            Задание.Наименование = Наименование;
            Задание.Использование = Использование;
            Задание = ЗаписатьЗаданиеПлатформы(Задание);
        КонецЕсли;
    Исключение
        Возврат РезультатОперации(
            Ложь,
            "SCHEDULE_SAVE_FAILED",
            ОписаниеОшибки());
    КонецПопытки;

    Возврат РезультатОперации(Истина, "", "", Задание, Создано);

КонецФункции

Функция ИзменитьЗадание(Задание, Свойства) Экспорт

    ПроверитьАдминистратораБотов();

    Если Задание = Неопределено
        ИЛИ ТипЗнч(Свойства) <> Тип("Структура") Тогда
        ВызватьИсключение "Для изменения задания необходим объект задания и структура свойств.";
    КонецЕсли;

    Владелец = Неопределено;
    Если НЕ Свойства.Свойство("Владелец", Владелец)
        ИЛИ Владелец = Неопределено
        ИЛИ НЕ ПДМ_УБТ_Права.ИзменениеРазрешено(Владелец) Тогда
        ВызватьИсключение "Недостаточно прав на изменение владельца регламентного задания.";
    КонецЕсли;

    ИдентификаторПользователяИБ = Неопределено;
    Если Свойства.Свойство("ИдентификаторПользователяИБ", ИдентификаторПользователяИБ) Тогда
        ПользовательИБ = ПользователиИнформационнойБазы.НайтиПоУникальномуИдентификатору(
            ИдентификаторПользователяИБ);
        Если ПользовательИБ = Неопределено Тогда
            Возврат РезультатОперации(
                Ложь,
                "SCHEDULE_USER_NOT_FOUND",
                "Пользователь информационной базы для регламентного задания не найден.");
        КонецЕсли;
        Задание.ИмяПользователя = ПользовательИБ;
    КонецЕсли;

    ЗначениеСвойства = Неопределено;
    Если Свойства.Свойство("Параметры", ЗначениеСвойства) Тогда
        Если ТипЗнч(ЗначениеСвойства) <> Тип("Массив") Тогда
            ВызватьИсключение "Параметры регламентного задания должны быть массивом.";
        КонецЕсли;
        Задание.Параметры = ЗначениеСвойства;
    КонецЕсли;

    Если Свойства.Свойство("Расписание", ЗначениеСвойства) Тогда
        Задание.Расписание = ЗначениеСвойства;
    КонецЕсли;
    Если Свойства.Свойство("Наименование", ЗначениеСвойства) Тогда
        Задание.Наименование = ЗначениеСвойства;
    КонецЕсли;
    Если Свойства.Свойство("Использование", ЗначениеСвойства) Тогда
        Задание.Использование = ЗначениеСвойства;
    КонецЕсли;

    Попытка
        Задание = ЗаписатьЗаданиеПлатформы(Задание);
    Исключение
        Возврат РезультатОперации(Ложь, "SCHEDULE_UPDATE_FAILED", ОписаниеОшибки());
    КонецПопытки;

    Возврат РезультатОперации(Истина, "", "", Задание);

КонецФункции

Процедура УдалитьЗадание(Задание, Владелец) Экспорт

    ПроверитьАдминистратораБотов();

    Если Задание = Неопределено
        ИЛИ НЕ ПДМ_УБТ_Права.ИзменениеРазрешено(Владелец) Тогда
        ВызватьИсключение "Недостаточно прав для удаления регламентного задания.";
    КонецЕсли;

    УстановитьПривилегированныйРежим(Истина);
    Попытка
        Если Задание.Метаданные.Предопределенное Тогда
            Задание.Использование = Ложь;
            Задание.Записать();
        Иначе
            Задание.Удалить();
        КонецЕсли;
    Исключение
        ТекстОшибки = ОписаниеОшибки();
        УстановитьПривилегированныйРежим(Ложь);
        ВызватьИсключение ТекстОшибки;
    КонецПопытки;
    УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
