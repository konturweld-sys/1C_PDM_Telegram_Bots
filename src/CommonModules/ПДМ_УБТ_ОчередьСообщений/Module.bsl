// Серверная очередь отправки Telegram и Email.
// Повторная отправка успешных получателей запрещена.
// Зависшие состояния «Отправляется» повторяются только после таймаута 30 минут.

Функция РезультатДоставки(Успех, ВнешнийИдентификатор = "", ТекстОшибки = "")

    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("ВнешнийИдентификатор", ВнешнийИдентификатор);
    Результат.Вставить("ТекстОшибки", ТекстОшибки);

    Возврат Результат;

КонецФункции

Процедура ПроверитьПравоНаОтправку()

    Если НЕ РольДоступна("ПДМ_УБТ_ОператорСообщений")
        И НЕ РольДоступна("УБТ_АдминистраторБотовTelegram") Тогда
        ВызватьИсключение "Недостаточно прав для отправки сообщений Telegram/Email.";
    КонецЕсли;

КонецПроцедуры

Функция ПрочитатьЗаписьДоставки(СсылкаСообщения, НомерПолучателя)

    Запись = РегистрыСведений.ПДМ_УБТ_ДоставкиСообщений.СоздатьМенеджерЗаписи();
    Запись.Сообщение = СсылкаСообщения;
    Запись.НомерПолучателя = НомерПолучателя;
    Запись.Прочитать();

    Возврат Запись;

КонецФункции

Процедура ЗаписатьДоставку(
    СсылкаСообщения,
    НомерПолучателя,
    Статус,
    ТекстОшибки = "",
    ВнешнийИдентификатор = "",
    УвеличитьПопытку = Ложь)

    Запись = ПрочитатьЗаписьДоставки(СсылкаСообщения, НомерПолучателя);

    Если НЕ ЗначениеЗаполнено(Запись.КоличествоПопыток) Тогда
        Запись.КоличествоПопыток = 0;
    КонецЕсли;

    Если УвеличитьПопытку Тогда
        Запись.КоличествоПопыток = Запись.КоличествоПопыток + 1;
        Запись.ДатаПоследнейПопытки = ТекущаяДатаСеанса();
    КонецЕсли;

    Запись.Статус = Статус;
    Запись.ТекстОшибки = ТекстОшибки;

    Если НЕ ПустаяСтрока(ВнешнийИдентификатор) Тогда
        Запись.ВнешнийИдентификатор = ВнешнийИдентификатор;
    КонецЕсли;

    Если Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено Тогда
        Запись.ДатаУспешнойОтправки = ТекущаяДатаСеанса();
        Запись.ТекстОшибки = "";
    КонецЕсли;

    Запись.Записать();

КонецПроцедуры

Функция ПолучитьРежимРазметки(ФорматТекста)

    Формат = ВРег(Строка(ФорматТекста));

    Если Формат = "HTML" Тогда
        Возврат "HTML";
    ИначеЕсли Формат = "MARKDOWN" Тогда
        Возврат "Markdown";
    КонецЕсли;

    Возврат "";

КонецФункции

Функция ОтправитьВTelegram(ОбъектСообщения, СтрокаПолучателя)

    Если НЕ ЗначениеЗаполнено(СтрокаПолучателя.ЧатTelegram) Тогда
        Возврат РезультатДоставки(Ложь, "", "Не выбран чат Telegram.");
    КонецЕсли;

    ЧатОбъект = СтрокаПолучателя.ЧатTelegram.ПолучитьОбъект();
    Бот = ЧатОбъект.Владелец;

    Если ЗначениеЗаполнено(ОбъектСообщения.БотTelegram) Тогда
        Если ОбъектСообщения.БотTelegram <> Бот Тогда
            Возврат РезультатДоставки(Ложь, "", "Выбранный бот не принадлежит указанному чату.");
        КонецЕсли;
        Бот = ОбъектСообщения.БотTelegram;
    КонецЕсли;

    Если НЕ ЗначениеЗаполнено(Бот) Тогда
        Возврат РезультатДоставки(Ложь, "", "Для чата не определён бот Telegram.");
    КонецЕсли;

    ИдентификаторЧата = ЧатОбъект.Код;
    РежимРазметки = ПолучитьРежимРазметки(ОбъектСообщения.ФорматТекста);
    КоличествоВложений = ОбъектСообщения.Вложения.Количество();

    Если КоличествоВложений = 0 Тогда

        Если ПустаяСтрока(ОбъектСообщения.ТекстСообщения) Тогда
            Возврат РезультатДоставки(Ложь, "", "Сообщение Telegram не содержит текста или вложений.");
        КонецЕсли;

        Сообщение = УБТ_РаботаСБотамиTelegram.НоваяСтруктураСообщенияЧата();
        Сообщение.chat_id = ИдентификаторЧата;
        Сообщение.text = ОбъектСообщения.ТекстСообщения;
        Сообщение.parse_mode = РежимРазметки;

        Ответ = УБТ_РаботаСБотамиTelegram.ОтправитьСообщениеВЧат(Бот, Сообщение);

        Если Ответ = Неопределено Тогда
            Возврат РезультатДоставки(Ложь, "", "Telegram API не вернул результат отправки сообщения.");
        КонецЕсли;

        Успешно = Ложь;
        Ответ.Свойство("ok", Успешно);
        Если НЕ Успешно Тогда
            Возврат РезультатДоставки(Ложь, "", "Telegram API отклонил отправку сообщения.");
        КонецЕсли;

        ВнешнийИдентификатор = "";
        Если Ответ.Свойство("result", РезультатОтвета) И РезультатОтвета.Свойство("message_id", ИдентификаторСообщения) Тогда
            ВнешнийИдентификатор = Строка(ИдентификаторСообщения);
        КонецЕсли;

        Возврат РезультатДоставки(Истина, ВнешнийИдентификатор);

    КонецЕсли;

    Если КоличествоВложений > 10 Тогда
        Возврат РезультатДоставки(Ложь, "", "Telegram поддерживает не более 10 файлов в одной группе медиа.");
    КонецЕсли;

    Если КоличествоВложений = 1 Тогда

        Вложение = ОбъектСообщения.Вложения[0];
        ДвоичныеДанные = Вложение.ДвоичныеДанные.Получить();

        СообщениеДокумента = УБТ_РаботаСБотамиTelegram.НоваяСтруктураСообщенияСДокументом();
        СообщениеДокумента.chat_id = ИдентификаторЧата;
        СообщениеДокумента.binary = ДвоичныеДанные;
        СообщениеДокумента.filename = Вложение.ИмяФайла;
        СообщениеДокумента.caption = ОбъектСообщения.ТекстСообщения;
        СообщениеДокумента.parse_mode = РежимРазметки;

        ТелоЗапроса = УБТ_РаботаСБотамиTelegram.ТелоВыгрузкиДокумента(СообщениеДокумента);
        Успешно = УБТ_РаботаСБотамиTelegram.ОтправитьДокументВЧат(Бот, ТелоЗапроса);

        Если НЕ Успешно Тогда
            Возврат РезультатДоставки(Ложь, "", "Telegram API не подтвердил отправку документа.");
        КонецЕсли;

        Возврат РезультатДоставки(Истина);

    КонецЕсли;

    СообщениеМедиафайлов = УБТ_РаботаСБотамиTelegram.НоваяСтруктураСообщенияМедиафайлов();
    СообщениеМедиафайлов.chat_id = ИдентификаторЧата;

    Для ИндексВложения = 0 По КоличествоВложений - 1 Цикл

        Вложение = ОбъектСообщения.Вложения[ИндексВложения];
        Медиа = УБТ_РаботаСБотамиTelegram.НоваяСтруктураМедиа();
        Медиа.type = "document";
        Медиа.binary = Вложение.ДвоичныеДанные.Получить();
        Медиа.filename = Вложение.ИмяФайла;

        Если ИндексВложения = 0 Тогда
            Медиа.caption = ОбъектСообщения.ТекстСообщения;
            Медиа.parse_mode = РежимРазметки;
        Иначе
            Медиа.caption = "";
            Медиа.parse_mode = "";
        КонецЕсли;

        СообщениеМедиафайлов.media.Добавить(Медиа);

    КонецЦикла;

    ТелоЗапроса = УБТ_РаботаСБотамиTelegram.ТелоВыгрузкиГруппыМедиафайлов(СообщениеМедиафайлов);
    Ответ = УБТ_РаботаСБотамиTelegram.ОтправитьГруппуМедиафайловВЧат(Бот, ТелоЗапроса);

    Если Ответ = Неопределено Тогда
        Возврат РезультатДоставки(Ложь, "", "Telegram API не подтвердил отправку группы медиафайлов.");
    КонецЕсли;

    Успешно = Ложь;
    Ответ.Свойство("ok", Успешно);
    Если НЕ Успешно Тогда
        Возврат РезультатДоставки(Ложь, "", "Telegram API отклонил отправку группы медиафайлов.");
    КонецЕсли;

    ВнешнийИдентификатор = "";
    Если Ответ.Свойство("result", РезультатОтвета) Тогда
        Если ТипЗнч(РезультатОтвета) = Тип("Массив") И РезультатОтвета.Количество() > 0 Тогда
            Если РезультатОтвета[0].Свойство("message_id", ИдентификаторСообщения) Тогда
                ВнешнийИдентификатор = Строка(ИдентификаторСообщения);
            КонецЕсли;
        КонецЕсли;
    КонецЕсли;

    Возврат РезультатДоставки(Истина, ВнешнийИдентификатор);

КонецФункции

Функция ОтправитьПоEmail(ОбъектСообщения, СтрокаПолучателя)

    Если ПустаяСтрока(СтрокаПолучателя.АдресЭлектроннойПочты) Тогда
        Возврат РезультатДоставки(Ложь, "", "Не задан адрес электронной почты получателя.");
    КонецЕсли;

    Получатели = Новый Массив;
    Получатели.Добавить(СтрокаПолучателя.АдресЭлектроннойПочты);

    Вложения = Новый Массив;
    Для Каждого Вложение Из ОбъектСообщения.Вложения Цикл
        Вложения.Добавить(
            Новый Структура(
                "ИмяФайла,ДвоичныеДанные",
                Вложение.ИмяФайла,
                Вложение.ДвоичныеДанные));
    КонецЦикла;

    ПараметрыОтправки = Новый Структура;
    ПараметрыОтправки.Вставить("Получатели", Получатели);
    ПараметрыОтправки.Вставить("Тема", ОбъектСообщения.Тема);
    ПараметрыОтправки.Вставить("Текст", ОбъектСообщения.ТекстСообщения);
    ПараметрыОтправки.Вставить("Формат", Строка(ОбъектСообщения.ФорматТекста));
    ПараметрыОтправки.Вставить("Вложения", Вложения);

    РезультатEmail = ПДМ_УБТ_Email.ОтправитьЭлектронноеСообщение(ПараметрыОтправки);

    Если НЕ РезультатEmail.Успех Тогда
        Возврат РезультатДоставки(Ложь, РезультатEmail.ИдентификаторСообщения, РезультатEmail.ТекстОшибки);
    КонецЕсли;

    Возврат РезультатДоставки(Истина, РезультатEmail.ИдентификаторСообщения);

КонецФункции

Функция ОтправитьПолучателю(ОбъектСообщения, СтрокаПолучателя)

    Если ОбъектСообщения.Канал = Перечисления.УБТ_ВидыЭлектронныхСообщений.Telegram Тогда
        Возврат ОтправитьВTelegram(ОбъектСообщения, СтрокаПолучателя);
    ИначеЕсли ОбъектСообщения.Канал = Перечисления.УБТ_ВидыЭлектронныхСообщений.ЭлектронноеПисьмо Тогда
        Возврат ОтправитьПоEmail(ОбъектСообщения, СтрокаПолучателя);
    КонецЕсли;

    Возврат РезультатДоставки(Ложь, "", "Неизвестный канал отправки.");

КонецФункции

Процедура ОбработатьСообщение(СсылкаСообщения)

    ОбъектСообщения = СсылкаСообщения.ПолучитьОбъект();

    Если ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Отправлено
        ИЛИ ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Отменено Тогда
        Возврат;
    КонецЕсли;

    ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Отправляется;
    ОбъектСообщения.ТекстОшибки = "";
    ОбъектСообщения.Записать();

    КоличествоУспешных = 0;
    КоличествоОшибок = 0;
    КоличествоВРаботе = 0;
    КоличествоОтменено = 0;
    ПерваяОшибка = "";
    ПоследнийВнешнийИдентификатор = "";

    Для ИндексПолучателя = 0 По ОбъектСообщения.Получатели.Количество() - 1 Цикл

        СтрокаПолучателя = ОбъектСообщения.Получатели[ИндексПолучателя];
        ЗаписьДоставки = ПрочитатьЗаписьДоставки(СсылкаСообщения, ИндексПолучателя);

        Если ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено Тогда
            СтрокаПолучателя.СтатусДоставки = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено;
            СтрокаПолучателя.ИдентификаторВнешнегоСообщения = ЗаписьДоставки.ВнешнийИдентификатор;
            СтрокаПолучателя.ТекстОшибки = "";
            КоличествоУспешных = КоличествоУспешных + 1;
            Продолжить;
        КонецЕсли;

        Если ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отменено Тогда
            КоличествоОтменено = КоличествоОтменено + 1;
            Продолжить;
        КонецЕсли;

        Если ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправляется
            И ЗначениеЗаполнено(ЗаписьДоставки.ДатаПоследнейПопытки)
            И ЗаписьДоставки.ДатаПоследнейПопытки > ТекущаяДатаСеанса() - 1800 Тогда
            СтрокаПолучателя.СтатусДоставки = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправляется;
            КоличествоВРаботе = КоличествоВРаботе + 1;
            Продолжить;
        КонецЕсли;

        Если ЗаписьДоставки.КоличествоПопыток >= 5 Тогда
            ЗаписатьДоставку(
                СсылкаСообщения,
                ИндексПолучателя,
                Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка,
                "Достигнут лимит автоматических попыток отправки.");
            СтрокаПолучателя.СтатусДоставки = Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка;
            СтрокаПолучателя.ТекстОшибки = "Достигнут лимит автоматических попыток отправки.";
            КоличествоОшибок = КоличествоОшибок + 1;
            Продолжить;
        КонецЕсли;

        ЗаписатьДоставку(
            СсылкаСообщения,
            ИндексПолучателя,
            Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправляется,
            "",
            "",
            Истина);

        Попытка
            Результат = ОтправитьПолучателю(ОбъектСообщения, СтрокаПолучателя);
        Исключение
            Результат = РезультатДоставки(Ложь, "", ОписаниеОшибки());
        КонецПопытки;

        Если Результат.Успех Тогда

            ЗаписатьДоставку(
                СсылкаСообщения,
                ИндексПолучателя,
                Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено,
                "",
                Результат.ВнешнийИдентификатор);

            СтрокаПолучателя.СтатусДоставки = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено;
            СтрокаПолучателя.ИдентификаторВнешнегоСообщения = Результат.ВнешнийИдентификатор;
            СтрокаПолучателя.ТекстОшибки = "";

            КоличествоУспешных = КоличествоУспешных + 1;
            ПоследнийВнешнийИдентификатор = Результат.ВнешнийИдентификатор;

        Иначе

            ЗаписатьДоставку(
                СсылкаСообщения,
                ИндексПолучателя,
                Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка,
                Результат.ТекстОшибки);

            СтрокаПолучателя.СтатусДоставки = Перечисления.ПДМ_УБТ_СтатусыДоставки.Ошибка;
            СтрокаПолучателя.ТекстОшибки = Результат.ТекстОшибки;

            КоличествоОшибок = КоличествоОшибок + 1;
            Если ПустаяСтрока(ПерваяОшибка) Тогда
                ПерваяОшибка = Результат.ТекстОшибки;
            КонецЕсли;

        КонецЕсли;

    КонецЦикла;

    Если ОбъектСообщения.Получатели.Количество() = 0 Тогда
        ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Ошибка;
        ОбъектСообщения.ТекстОшибки = "Не заданы получатели сообщения.";
    ИначеЕсли КоличествоУспешных = ОбъектСообщения.Получатели.Количество() Тогда
        ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Отправлено;
        ОбъектСообщения.ТекстОшибки = "";
    ИначеЕсли КоличествоУспешных = 0
        И КоличествоОшибок = 0
        И КоличествоВРаботе > 0 Тогда
        ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Отправляется;
        ОбъектСообщения.ТекстОшибки = "";
    ИначеЕсли КоличествоУспешных > 0
        ИЛИ КоличествоВРаботе > 0
        ИЛИ КоличествоОтменено > 0 Тогда
        ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.ЧастичноОтправлено;
        ОбъектСообщения.ТекстОшибки = ПерваяОшибка;
    Иначе
        ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.Ошибка;
        ОбъектСообщения.ТекстОшибки = ПерваяОшибка;
    КонецЕсли;

    Если НЕ ПустаяСтрока(ПоследнийВнешнийИдентификатор) Тогда
        ОбъектСообщения.ИдентификаторВнешнегоСообщения = ПоследнийВнешнийИдентификатор;
    КонецЕсли;

    ОбъектСообщения.Записать();

КонецПроцедуры

Процедура ОбработатьОчередь(ЛимитПакета = 50) Экспорт

    ПроверитьПравоНаОтправку();

    Если ЛимитПакета <= 0 Тогда
        ВызватьИсключение "Лимит пакета должен быть больше нуля.";
    КонецЕсли;

    Запрос = Новый Запрос;
    Запрос.Текст =
    "ВЫБРАТЬ ПЕРВЫЕ &ЛимитПакета
    |   Сообщения.Ссылка КАК Ссылка
    |ИЗ
    |   Документ.ПДМ_УБТ_Сообщения КАК Сообщения
    |ГДЕ
    |   Сообщения.СтатусОтправки = &ОжидаетОтправки
    |   ИЛИ Сообщения.СтатусОтправки = &ЧастичноОтправлено
    |   ИЛИ Сообщения.СтатусОтправки = &Отправляется
    |УПОРЯДОЧИТЬ ПО
    |   Сообщения.Дата";

    Запрос.УстановитьПараметр("ЛимитПакета", ЛимитПакета);
    Запрос.УстановитьПараметр(
        "ОжидаетОтправки",
        Перечисления.ПДМ_УБТ_СтатусыСообщений.ОжидаетОтправки);
    Запрос.УстановитьПараметр(
        "ЧастичноОтправлено",
        Перечисления.ПДМ_УБТ_СтатусыСообщений.ЧастичноОтправлено);
    Запрос.УстановитьПараметр(
        "Отправляется",
        Перечисления.ПДМ_УБТ_СтатусыСообщений.Отправляется);

    Выборка = Запрос.Выполнить().Выбрать();

    Пока Выборка.Следующий() Цикл
        Попытка
            ОбработатьСообщение(Выборка.Ссылка);
        Исключение
            ЗаписьЖурналаРегистрации(
                "ПДМ_УБТ_ОчередьСообщений",
                УровеньЖурналаРегистрации.Ошибка,
                Метаданные.Документы.ПДМ_УБТ_Сообщения,
                Выборка.Ссылка,
                ОписаниеОшибки());
        КонецПопытки;
    КонецЦикла;

КонецПроцедуры

Процедура ПовторитьОтправку(СсылкаСообщения) Экспорт

    ПроверитьПравоНаОтправку();

    Если НЕ ЗначениеЗаполнено(СсылкаСообщения)
        ИЛИ НЕ ПравоДоступа("Изменение", СсылкаСообщения) Тогда
        ВызватьИсключение "Недостаточно прав на повторную отправку сообщения.";
    КонецЕсли;

    ОбъектСообщения = СсылкаСообщения.ПолучитьОбъект();

    Если ОбъектСообщения.СтатусОтправки <> Перечисления.ПДМ_УБТ_СтатусыСообщений.Ошибка
        И ОбъектСообщения.СтатусОтправки <> Перечисления.ПДМ_УБТ_СтатусыСообщений.ЧастичноОтправлено Тогда
        ВызватьИсключение "Повторная отправка доступна только для сообщений с ошибкой или частичной отправкой.";
    КонецЕсли;

    КоличествоКПовтору = 0;

    Для ИндексПолучателя = 0 По ОбъектСообщения.Получатели.Количество() - 1 Цикл

        ЗаписьДоставки = ПрочитатьЗаписьДоставки(СсылкаСообщения, ИндексПолучателя);

        Если ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отправлено
            ИЛИ ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.Отменено Тогда
            Продолжить;
        КонецЕсли;

        ЗаписьДоставки.Статус = Перечисления.ПДМ_УБТ_СтатусыДоставки.ПовторнаяПопытка;
        ЗаписьДоставки.КоличествоПопыток = 0;
        ЗаписьДоставки.ДатаПоследнейПопытки = Дата(1, 1, 1);
        ЗаписьДоставки.ТекстОшибки = "";
        ЗаписьДоставки.Записать();

        ОбъектСообщения.Получатели[ИндексПолучателя].СтатусДоставки =
            Перечисления.ПДМ_УБТ_СтатусыДоставки.ПовторнаяПопытка;
        ОбъектСообщения.Получатели[ИндексПолучателя].ТекстОшибки = "";

        КоличествоКПовтору = КоличествоКПовтору + 1;

    КонецЦикла;

    Если КоличествоКПовтору = 0 Тогда
        ВызватьИсключение "Нет получателей, для которых требуется повторная отправка.";
    КонецЕсли;

    ОбъектСообщения.СтатусОтправки = Перечисления.ПДМ_УБТ_СтатусыСообщений.ОжидаетОтправки;
    ОбъектСообщения.ТекстОшибки = "";
    ОбъектСообщения.Записать();

КонецПроцедуры
