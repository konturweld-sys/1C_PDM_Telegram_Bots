#Область ПрограммныйИнтерфейс

// Выгружает сценарий Telegram бота в файл JSON.
// 
// Параметры:
//  Сценарий - СправочникСсылка.УБТ_СценарииБотовTelegram - Сценарий
Процедура ВыгрузитьСценарийБотаTelegramВФайл(Сценарий) Экспорт

	АдресФайлаВоВременномХранилище = УБТ_УправлениеБотамиTelegramСлужебныйВызовСервера.СохранитьJSONСхемуСценарияБотаTelegram(
		Сценарий);

	Если Не ПустаяСтрока(АдресФайлаВоВременномХранилище) Тогда

		ИмяФайла = Строка(Сценарий) + ".json";

		ПолучаемыеФайлы = Новый Массив;
		ПолучаемыеФайлы.Добавить(Новый ОписаниеПередаваемогоФайла(ИмяФайла, АдресФайлаВоВременномХранилище));

		ДиалогВыбораФайла = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
		ДиалогВыбораФайла.ПолноеИмяФайла = ИмяФайла;
		ДиалогВыбораФайла.Фильтр = НСтр("az = 'JSON';en = 'JSON';ru = 'JSON'") + " (*.json)|*.json|";

		НачатьПолучениеФайлов(Неопределено, ПолучаемыеФайлы, ДиалогВыбораФайла, Истина);

	КонецЕсли;

КонецПроцедуры

#КонецОбласти