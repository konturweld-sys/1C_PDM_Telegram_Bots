// Серверные проверки полномочий Telegram-библиотеки PDM.

#Область ПрограммныйИнтерфейс
// Проверяет, разрешено ли изменение указанного объекта.
//
// Параметры:
//  Ссылка - Произвольный - ссылка объекта, для которого проверяются права.
//
// Возвращаемое значение:
//  Булево - Истина, если изменение разрешено; Ложь в противном случае.
Функция ИзменениеРазрешено(Ссылка) Экспорт

    Если НЕ ЗначениеЗаполнено(Ссылка) Тогда
        Возврат Ложь;
    КонецЕсли;

    Если НЕ РольДоступна("УБТ_АдминистраторБотовTelegram") Тогда
        Возврат Ложь;
    КонецЕсли;

    Возврат ПравоДоступа("Изменение", Ссылка);

КонецФункции

// Проверяет, разрешено ли выполнение произвольного BSL-кода.
//
// Возвращаемое значение:
//  Булево - Истина, если выполнение разрешено; Ложь в противном случае.
Функция ВыполнениеПроизвольногоКодаРазрешено() Экспорт

    Возврат РольДоступна("УБТ_АдминистраторКонсоли");

КонецФункции
#КонецОбласти
