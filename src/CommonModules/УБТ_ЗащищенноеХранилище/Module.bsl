// Серверное хранилище токенов Telegram.
// Доступ к регистру выполняется только из серверного модуля с кратковременным
// включением привилегированного режима. По модели БСП данные недоступны
// пользователям напрямую; ValueStorage само по себе не является шифрованием.

Функция СсылкаНаБота(UUIDБота)

	Если ТипЗнч(UUIDБота) <> Тип("УникальныйИдентификатор")
		Или Не ЗначениеЗаполнено(UUIDБота) Тогда
		ВызватьИсключение "Не задан корректный идентификатор Telegram-бота.";
	КонецЕсли;

	Возврат Справочники.УБТ_БотыTelegram.ПолучитьСсылку(UUIDБота);

КонецФункции

Процедура ЗаписатьТокенБота(UUIDБота, Токен) Экспорт

	Если ТипЗнч(Токен) <> Тип("Строка") Или ПустаяСтрока(Токен) Тогда
		ВызватьИсключение "Не задан токен Telegram-бота.";
	КонецЕсли;

	СсылкаБота = СсылкаНаБота(UUIDБота);
	Запись = РегистрыСведений.УБТ_ЗащищенныеДанныеБотов.СоздатьМенеджерЗаписи();
	Запись.Бот = СсылкаБота;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись.Прочитать();
		Запись.Бот = СсылкаБота;
		Запись.Данные = Новый ХранилищеЗначения(Токен, Новый СжатиеДанных(9));
		Запись.ВерсияФормата = "1";
		Запись.ДатаИзменения = ТекущаяДатаСеанса();
		Запись.Записать();
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры

Функция ПрочитатьТокенБота(UUIDБота) Экспорт

	СсылкаБота = СсылкаНаБота(UUIDБота);
	Запись = РегистрыСведений.УБТ_ЗащищенныеДанныеБотов.СоздатьМенеджерЗаписи();
	Запись.Бот = СсылкаБота;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись.Прочитать();
		Если Не Запись.Выбран() Или ТипЗнч(Запись.Данные) <> Тип("ХранилищеЗначения") Тогда
			Токен = "";
		Иначе
			Токен = Запись.Данные.Получить();
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

	Если ТипЗнч(Токен) <> Тип("Строка") Тогда
		Возврат "";
	КонецЕсли;

	Возврат Токен;

КонецФункции

Процедура УдалитьТокенБота(UUIDБота) Экспорт

	СсылкаБота = СсылкаНаБота(UUIDБота);
	Запись = РегистрыСведений.УБТ_ЗащищенныеДанныеБотов.СоздатьМенеджерЗаписи();
	Запись.Бот = СсылкаБота;

	УстановитьПривилегированныйРежим(Истина);
	Попытка
		Запись.Прочитать();
		Если Запись.Выбран() Тогда
			Запись.Удалить();
		КонецЕсли;
	Исключение
		УстановитьПривилегированныйРежим(Ложь);
		ВызватьИсключение;
	КонецПопытки;
	УстановитьПривилегированныйРежим(Ложь);

КонецПроцедуры
