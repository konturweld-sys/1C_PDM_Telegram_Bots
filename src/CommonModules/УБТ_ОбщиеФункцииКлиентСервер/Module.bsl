//
// Возвращаемое значение:
// Строка - Код основного языка.
Функция КодОсновногоЯзыка() Экспорт
	Возврат "ru";
КонецФункции

// Определяет, включено ли разделение данных в конфигурации PDM.
//
// Возвращаемое значение:
// Булево - Ложь, поскольку разделение данных не используется.
Функция РазделениеВключено() Экспорт
	Возврат Ложь;
КонецФункции

// Формирует путь к полю строки табличной части для объекта СообщениеПользователю.
// НомерСтроки соответствует номеру строки табличной части, начинающемуся с 1.
//
// Возвращаемое значение:
//  Строка - Путь к указанному полю строки табличной части.
// Формирует путь к полю строки табличной части для объекта СообщениеПользователю.
//
// Параметры:
// ПутьТЧ - Строка - Имя табличной части.
// НомерСтроки - Число - Номер строки табличной части, начиная с 1.
// ИмяПоля - Строка - Имя поля табличной части.
//
// Возвращаемое значение:
// Строка - Путь к указанному полю строки табличной части.
Функция ПутьКТабличнойЧасти(ПутьТЧ, НомерСтроки, ИмяПоля) Экспорт

	Если НЕ ЗначениеЗаполнено(ПутьТЧ) Тогда
		ВызватьИсключение "Не задан путь к табличной части.";
	КонецЕсли;

	Если ТипЗнч(НомерСтроки) <> Тип("Число")
		ИЛИ НомерСтроки < 1
		ИЛИ НомерСтроки <> Цел(НомерСтроки) Тогда
		ВызватьИсключение "Номер строки табличной части должен быть положительным целым числом.";
	КонецЕсли;

	Если НЕ ЗначениеЗаполнено(ИмяПоля) Тогда
		ВызватьИсключение "Не задано имя поля табличной части.";
	КонецЕсли;

	Возврат СтрШаблон(
		"%1[%2].%3",
		ПутьТЧ,
		Формат(НомерСтроки - 1, "ЧН=0; ЧГ="),
		ИмяПоля);

КонецФункции

// Выполняет проверку метаданных перед запуском регламентного задания.
//
// Параметры:
// МетаданныеЗадания - ОбъектМетаданныхРегламентноеЗадание - Метаданные регламентного задания.
Процедура ПриНачалеВыполненияРегламентногоЗадания(МетаданныеЗадания) Экспорт

	Если МетаданныеЗадания = Неопределено Тогда
		ВызватьИсключение "Не переданы метаданные регламентного задания.";
	КонецЕсли;

	// В PDM нет ERP/BSP-подсистемы функциональных опций и модели сервиса.
	// Проверка наличия метаданных сохраняет контракт вызова без фиктивной зависимости.

КонецПроцедуры

#Если Сервер Тогда
// Создаёт новое защищённое SSL-соединение.
//
// Возвращаемое значение:
// ЗащищенноеСоединениеOpenSSL - Созданное защищённое соединение.
Функция НовоеЗащищенноеСоединение() Экспорт
	Возврат Новый ЗащищенноеСоединениеOpenSSL();
КонецФункции
#КонецЕсли

// Выводит сообщение пользователю и устанавливает признак отказа.
// Реализация повторяет контракт PDM ОбщегоНазначенияКлиентСервер.
//
// Параметры:
// Текст - Строка - Текст выводимого сообщения.
// КлючДанных - Произвольный - Объект информационной базы или ключ данных формы.
// Поле - Строка - Имя поля, к которому относится сообщение.
// ПутьКДанным - Строка - Путь к данным объекта или формы.
// Отказ - Булево - Признак отказа, устанавливаемый в Истина.
Процедура СообщитьПользователю(
		Знач Текст,
		Знач КлючДанных = Неопределено,
		Знач Поле = "",
		Знач ПутьКДанным = "",
		Отказ = Ложь) Экспорт

	Сообщение = Новый СообщениеПользователю;
	Сообщение.Текст = Текст;
	Сообщение.Поле = Поле;

	ЭтоОбъект = Ложь;

#Если НЕ ТонкийКлиент И НЕ ВебКлиент Тогда
	Если КлючДанных <> Неопределено
		И XMLТипЗнч(КлючДанных) <> Неопределено Тогда
		ТипЗначенияСтрокой = XMLТипЗнч(КлючДанных).ИмяТипа;
		ЭтоОбъект = СтрНайти(ТипЗначенияСтрокой, "Object.") > 0;
	КонецЕсли;
#КонецЕсли

	Если ЭтоОбъект Тогда
		Сообщение.УстановитьДанные(КлючДанных);
	Иначе
		Сообщение.КлючДанных = КлючДанных;
	КонецЕсли;

	Если НЕ ПустаяСтрока(ПутьКДанным) Тогда
		Сообщение.ПутьКДанным = ПутьКДанным;
	КонецЕсли;

	Сообщение.Сообщить();

	Отказ = Истина;

КонецПроцедуры
#КонецОбласти
