// Серверное формирование отчётов PDM по сохранённым вариантам СКД.

#Область ПрограммныйИнтерфейс
// Формирует табличный документ по сохранённому варианту отчёта.
//
// Параметры:
// СсылкаВарианта - СправочникСсылка.УБТ_ВариантыОтчетов - Ссылка на вариант отчёта.
// ПараметрыФормирования - Структура - Дополнительные параметры формирования отчёта.
//
// Возвращаемое значение:
// Структура - Результат формирования, включая статус, описание ошибки и табличный документ.
Функция СформироватьОтчет(СсылкаВарианта, ПараметрыФормирования) Экспорт

    Если НЕ ЗначениеЗаполнено(СсылкаВарианта) Тогда
        Возврат РезультатФормирования(
            Ложь,
            "REPORT_VARIANT_EMPTY",
            "Не задан вариант отчёта.");
    КонецЕсли;

    Если ТипЗнч(ПараметрыФормирования) <> Тип("Структура") Тогда
        ПараметрыФормирования = Новый Структура;
    КонецЕсли;

    Если НЕ ПравоДоступа("Чтение", СсылкаВарианта) Тогда
        Возврат РезультатФормирования(
            Ложь,
            "REPORT_VARIANT_ACCESS_DENIED",
            "Нет прав на чтение варианта отчёта.",
            СсылкаВарианта);
    КонецЕсли;

    Попытка

        ВариантОбъект = СсылкаВарианта.ПолучитьОбъект();

        Если НЕ ВариантОбъект.Используется Тогда
            Возврат РезультатФормирования(
                Ложь,
                "REPORT_VARIANT_DISABLED",
                "Выбранный вариант отчёта отключён.",
                СсылкаВарианта);
        КонецЕсли;

        ИмяОтчета = СокрЛП(ВариантОбъект.ИмяОтчета);
        Если ПустаяСтрока(ИмяОтчета) Тогда
            Возврат РезультатФормирования(
                Ложь,
                "REPORT_METADATA_NAME_EMPTY",
                "В варианте отчёта не задано имя объекта отчёта PDM.",
                СсылкаВарианта);
        КонецЕсли;

        МетаданныеОтчета = Метаданные.Отчеты.Найти(ИмяОтчета);
        Если МетаданныеОтчета = Неопределено Тогда
            Возврат РезультатФормирования(
                Ложь,
                "REPORT_METADATA_NOT_FOUND",
                "Объект отчёта PDM не найден: " + ИмяОтчета,
                СсылкаВарианта);
        КонецЕсли;

        ОтчетОбъект = Отчеты[ИмяОтчета].Создать();
        СхемаКомпоновкиДанных = ОтчетОбъект.ПолучитьМакет("ОсновнаяСхемаКомпоновкиДанных");

        Если СхемаКомпоновкиДанных = Неопределено Тогда
            Возврат РезультатФормирования(
                Ложь,
                "REPORT_SCHEMA_NOT_FOUND",
                "У отчёта отсутствует основная схема компоновки данных.",
                СсылкаВарианта);
        КонецЕсли;

        Настройки = СхемаКомпоновкиДанных.НастройкиПоУмолчанию;

        Если ЗначениеЗаполнено(ВариантОбъект.НастройкиФормирования) Тогда
            СохраненныеНастройки = ВариантОбъект.НастройкиФормирования.Получить();
            Если ТипЗнч(СохраненныеНастройки) <> Тип("НастройкиКомпоновкиДанных") Тогда
                Возврат РезультатФормирования(
                    Ложь,
                    "REPORT_SETTINGS_INVALID",
                    "Сохранённые настройки варианта имеют неверный тип.",
                    СсылкаВарианта);
            КонецЕсли;
            Настройки = СохраненныеНастройки;
        КонецЕсли;

        КомпоновщикМакета = Новый КомпоновщикМакетаКомпоновкиДанных;
        МакетКомпоновки = КомпоновщикМакета.Выполнить(
            СхемаКомпоновкиДанных,
            Настройки);

        ПроцессорКомпоновки = Новый ПроцессорКомпоновкиДанных;
        ПроцессорКомпоновки.Инициализировать(МакетКомпоновки);

        ТабличныйДокумент = Новый ТабличныйДокумент;
        ПроцессорВывода = Новый ПроцессорВыводаРезультатаКомпоновкиДанныхВТабличныйДокумент;
        ПроцессорВывода.УстановитьДокумент(ТабличныйДокумент);
        ПроцессорВывода.Вывести(ПроцессорКомпоновки);

        ФорматПоУмолчанию = Строка(ВариантОбъект.ФорматПоУмолчанию);
        Если ПустаяСтрока(ФорматПоУмолчанию) Тогда
            ФорматПоУмолчанию = "PDF";
        КонецЕсли;

        Расширения = Новый Массив;
        РасширенияИзПараметров = Новый Массив;
        Если ПараметрыФормирования.Свойство("Расширения", РасширенияИзПараметров)
            И ТипЗнч(РасширенияИзПараметров) = Тип("Массив") Тогда
            Для Каждого Расширение Из РасширенияИзПараметров Цикл
                Если НЕ ПустаяСтрока(Расширение)
                    И Расширения.Найти(ВРег(Расширение)) = Неопределено Тогда
                    Расширения.Добавить(ВРег(Расширение));
                КонецЕсли;
            КонецЦикла;
        КонецЕсли;

        Если Расширения.Количество() = 0 Тогда
            Расширения.Добавить(ВРег(ФорматПоУмолчанию));
        КонецЕсли;

        Результат = РезультатФормирования(Истина, "", "", СсылкаВарианта);
        Результат.ТабличныйДокумент = ТабличныйДокумент;
        Результат.НаименованиеФайла = ВариантОбъект.Наименование;
        Результат.Расширение = ВРег(ФорматПоУмолчанию);
        Результат.Расширения = Расширения;

        Возврат Результат;

    Исключение

        Возврат РезультатФормирования(
            Ложь,
            "REPORT_BUILD_FAILED",
            ОписаниеОшибки(),
            СсылкаВарианта);

    КонецПопытки;

КонецФункции
#КонецОбласти

#Область СлужебныеПроцедурыИФункции
// Формирует структуру результата выполнения отчёта.
//
// Возвращаемое значение:
// Структура:
//   Успех - Булево - признак успешного формирования.
//   КодОшибки - Строка - код ошибки или пустая строка при успехе.
//   ТекстОшибки - Строка - описание результата или ошибки.
//   СсылкаВарианта - Произвольный - ссылка на вариант отчёта либо Неопределено.
//   ТабличныйДокумент - Произвольный - сформированный табличный документ либо Неопределено.
//   НаименованиеФайла - Строка - наименование файла отчёта.
//   Расширение - Строка - расширение формата по умолчанию.
//   Расширения - Массив - список доступных расширений.
//
Функция РезультатФормирования(Успех, КодОшибки, ТекстОшибки, СсылкаВарианта = Неопределено)

    Результат = Новый Структура;
    Результат.Вставить("Успех", Успех);
    Результат.Вставить("КодОшибки", КодОшибки);
    Результат.Вставить("ТекстОшибки", ТекстОшибки);
    Результат.Вставить("СсылкаВарианта", СсылкаВарианта);
    Результат.Вставить("ТабличныйДокумент", Неопределено);
    Результат.Вставить("НаименованиеФайла", "");
    Результат.Вставить("Расширение", "");
    Результат.Вставить("Расширения", Новый Массив);

    Возврат Результат;

КонецФункции

#КонецОбласти
